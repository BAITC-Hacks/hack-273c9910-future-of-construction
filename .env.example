# Optional. Enables AI analysis and the simulator consultant chat.
# Without a key, the consultant uses a clearly labeled local reference mode.
# Simulation and scoring work without these values. Keep the key server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional absolute path on a persistent writable disk. Default: data/auth.sqlite
# AUTH_DATABASE_PATH=/srv/akim-data/auth.sqlite
